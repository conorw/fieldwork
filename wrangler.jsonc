{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fieldwork",
  "main": "workers/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/files/*"]
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "fieldwork-storage"
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "../../training/*.py",
        "../../training/requirements.txt",
        "../../scripts/export_browser_onnx.py"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "SOURCE_PMTILES_KEY": "pmtiles/OUTPUT.pmtiles",
    "SOURCE_PMTILES_URL": "https://build.protomaps.com/{date}.pmtiles",
    "HF_NAMESPACE": "conorwoods",
    "HF_JOB_FLAVOR": "l4x1",
    "TRAIN_REPO_URL": "https://github.com/conorw/fieldwork.git",
    "TRAIN_REPO_REF": "feature/cemetery-train-orchestrator",
    "GLOBAL_ADAPTER_URL": "/files/adapters/global/latest/",
    "VITE_GLOBAL_ADAPTER_URL": "/files/adapters/global/latest/",
    "SUPABASE_URL": "https://maqutdhaforvqbdsqxua.supabase.co",
    "VITE_SUPABASE_URL": "https://maqutdhaforvqbdsqxua.supabase.co",
    "STORAGE_PUBLIC_BASE": "https://fieldwork.conorw.workers.dev",
    "STORAGE_UPLOAD_URL": "https://fieldwork.conorw.workers.dev/api/storage"
  }
}
