{
  "name": "fieldwork",
  "version": "1.0.0",
  "description": "Local-first progressive web app for cemetery plot documentation and field data collection",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "test:api": "vercel dev && vitest run -t 'clips 1km×1km successfully'",
    "build": "vue-tsc && vite build",
