{
  "name": "fieldwork",
  "version": "1.0.0",
  "description": "Local-first progressive web app for cemetery plot documentation and field data collection",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,worker -c cyan,magenta \"vite dev\" \"wrangler dev --port 8787\"",
    "dev:vite": "vite dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vue-tsc && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "migrate:blob": "python scripts/migrate_vercel_blob_to_r2.py",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:clip": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/clip.spec.ts",
    "test:train": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/train",
    "test:train:py": "python -m unittest training.tests.test_schema_and_pipeline -v",
    "test:e2e": "playwright test",
    "test:e2e:onboarding": "playwright test e2e/onboarding-new-cemetery.spec.ts --project=chromium",
    "test:e2e:fone": "playwright test e2e/onboarding-fone-extract-plot.spec.ts --project=chromium && node e2e/helpers/collect-videos.mjs",
    "test:e2e:videos": "playwright test e2e/onboarding-new-cemetery.spec.ts e2e/usage-scenarios.spec.ts e2e/onboarding-fone-extract-plot.spec.ts --project=chromium && node e2e/helpers/collect-videos.mjs",
    "test:api": "wrangler dev --port 8787",
    "type-check": "vue-tsc --noEmit && tsc -p tsconfig.worker.json",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "eslint . --fix",
    "convert-icons": "node scripts/convert-icons.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@journeyapps/wa-sqlite": "^1.7.2",
    "@powersync/web": "^1.39.1",
    "@supabase/supabase-js": "^2.115.0",
    "@vueuse/core": "^14.4.0",
    "autoprefixer": "^10.5.5",
    "buffer": "^6.0.3",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "openai": "^6.49.0",
    "pinia": "^3.0.4",
    "pmtiles": "^4.5.0",
    "postcss": "^8.5.28",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vue": "3.6.0-rc.7",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.51.1",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^16.5.0",
    "ol": "^10.10.0",
    "ol-ext": "^4.0.38",
    "ol-pmtiles": "^2.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  },
  "keywords": [
    "cemetery",
    "fieldwork",
    "pwa",
    "offline-first",
    "mapping",
    "vue"
  ],
  "author": "Conor Woods",
  "license": "GPL"
}
