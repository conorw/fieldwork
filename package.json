{
  "name": "fieldwork",
  "version": "1.0.0",
  "description": "Local-first progressive web app for cemetery plot documentation and field data collection",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,worker -c cyan,magenta \"vite dev\" \"wrangler dev --port 8787\"",
    "dev:vite": "vite dev",
    "dev:worker": "wrangler dev --port 8787",
    "build": "svelte-kit sync && vite build && tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "migrate:blob": "python scripts/migrate_vercel_blob_to_r2.py",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:watch": "node ./node_modules/vitest/vitest.mjs --config vitest.config.ts",
    "test:clip": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/clip.spec.ts",
    "test:train": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/train",
    "test:train:py": "python -m unittest training.tests.test_schema_and_pipeline -v",
    "test:e2e": "playwright test",
    "test:e2e:onboarding": "playwright test e2e/onboarding-new-cemetery.spec.ts --project=chromium",
    "test:e2e:fone": "playwright test e2e/onboarding-fone-extract-plot.spec.ts --project=chromium && node e2e/helpers/collect-videos.mjs",
    "test:e2e:videos": "playwright test e2e/onboarding-new-cemetery.spec.ts e2e/usage-scenarios.spec.ts e2e/onboarding-fone-extract-plot.spec.ts --project=chromium && node e2e/helpers/collect-videos.mjs",
    "test:api": "wrangler dev --port 8787",
    "type-check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json",
    "type-check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint . --fix",
    "convert-icons": "node scripts/convert-icons.js"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@journeyapps/wa-sqlite": "^1.7.2",
    "@powersync/web": "^1.39.1",
    "@supabase/supabase-js": "^2.115.0",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "autoprefixer": "^10.5.5",
    "buffer": "^6.0.3",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "openai": "^6.49.0",
    "pmtiles": "^4.5.0",
    "postcss": "^8.5.28",
    "primeicons": "^7.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vue/compiler-dom": "^3.5.44",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "ol": "^10.10.0",
    "ol-ext": "^4.0.38",
    "ol-pmtiles": "^2.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "keywords": [
    "cemetery",
    "fieldwork",
    "pwa",
    "offline-first",
    "mapping",
    "sveltekit"
  ],
  "author": "Conor Woods",
  "license": "GPL"
}
