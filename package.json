    "@types/node": "^25.0.3",
    "@typescript-eslint/parser": "^8.50.1",
    "@vercel/node": "^5.5.16",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-prettier": "^10.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "ol": "^10.7.0",
    "ol-ext": "^4.0.37",
