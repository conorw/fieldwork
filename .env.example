# PowerSync Configuration (Required)
VITE_POWERSYNC_URL=your_powersync_url
VITE_POWERSYNC_DEV_TOKEN=your_dev_token

# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side Supabase (train APIs — service role updates location AI fields)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API Key (Required for GPT teacher / analyze-headstone)
OPENAI_API_KEY=your_openai_api_key

# Vercel Blob Storage (images + trained adapters)
BLOB_READ_WRITE_TOKEN=your_blob_token

# Per-cemetery local VLM training (Hugging Face Jobs orchestrator)
HF_TOKEN=hf_xxxxxxxx
HF_NAMESPACE=your-hf-username-or-org
HF_JOB_FLAVOR=l4x1
HF_JOB_TIMEOUT_SECONDS=3600
TRAIN_REPO_URL=https://github.com/conorw/fieldwork.git
TRAIN_REPO_REF=feature/cemetery-train-orchestrator
TRAIN_WEBHOOK_SECRET=generate-a-long-random-string
# Optional override if x-forwarded-host is wrong in prod
# TRAIN_WEBHOOK_BASE_URL=https://your-production-domain.com
